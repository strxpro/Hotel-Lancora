# ─────────────────────────────────────────────────────────────
# Hotel L'Ancora — configuration. Copy to .env.local and fill in.
# Nothing below is required to run the demo except SESSION_SECRET.
# Secrets are read only on the server and are never sent to the browser.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used in emails, Stripe return URLs, Telegram webhook)
APP_URL=http://localhost:3000

# Signs the admin session cookie. REQUIRED in production (≥ 32 random chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Demo mode: one-click demo login, "Ripristina dati demo", demo labels. Set to false in production.
DEMO_MODE=true

# Demo accounts created by the seed (change them, or set DEMO_MODE=false and change passwords in the panel)
DEMO_ADMIN_EMAIL=admin@lancora.demo
DEMO_ADMIN_PASSWORD=123
DEMO_STAFF_EMAIL=staff@lancora.demo
DEMO_STAFF_PASSWORD=123

# Where the demo JSON database and uploaded photos are stored (default ./data)
# DATA_DIR=./data

# ── AI provider (optional) ──────────────────────────────────
# EASIEST & FREE: a Groq key (console.groq.com → API Keys). One key = chat, emails, translations
# and voice messages (Whisper) in any language. You can also paste it in the panel:
# Impostazioni → Collegamenti → AI gratuita → Collega (stored in data/integrations.json).
# Optional image generation: secret key from enter.pollinations.ai, requires provider balance.
POLLINATIONS_TOKEN=
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# none | ollama | openai | anthropic
AI_PROVIDER=none
# Local, free: https://ollama.com  →  ollama pull llama3.1:8b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Any OpenAI-compatible endpoint (incl. providers with a free tier — limits are not guaranteed)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=45000

# Translations without an LLM: free MyMemory API (daily limits). Leave empty to disable.
TRANSLATION_PROVIDER=
MYMEMORY_EMAIL=

# ── Voice (optional) ─────────────────────────────────────────
# Voice uses Groq automatically when GROQ_API_KEY is set. Alternative: a local faster-whisper server
# with OpenAI-compatible /v1/audio/transcriptions (audio never leaves the hotel)
WHISPER_URL=
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_API_KEY=

# ── Telegram (optional) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# random string ≥ 16 chars, sent by Telegram in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# ── Stripe (optional, TEST keys only in demo) ────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Live keys are refused unless DEMO_MODE=false AND ALLOW_LIVE_PAYMENTS=true
ALLOW_LIVE_PAYMENTS=false

# ── Email (optional). Without SMTP every email goes to the Demo Outbox. ──
# Can also be connected from the panel (Impostazioni → Collegamenti → Email: Brevo / Gmail).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hotel L'Ancora <prenotazioni@example.com>"

# ── Channel manager / PMS (to be confirmed with the hotel) ──
CHANNEL_PROVIDER=

# Supabase: copia dei dati in cloud (Impostazioni → Collegamenti → Controlla e collega tutto)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
